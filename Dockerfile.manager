FROM node:22.14.0-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build:manager

FROM node:22.14.0-alpine AS manager
ENV NODE_ENV=production
WORKDIR /opt/magisform-runtime
RUN apk add --no-cache docker-cli docker-cli-compose openssl
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build --chown=node:node /app/dist-server ./dist-server
COPY --from=build --chown=node:node /app/dist-manager ./dist-manager
COPY --from=build --chown=node:node /app/deploy/tenant-template ./deploy/tenant-template
COPY --from=build --chown=node:node /app/scripts/provision-tenant.mjs ./scripts/provision-tenant.mjs
COPY --from=build --chown=node:node /app/scripts/manager-setup.mjs ./scripts/manager-setup.mjs
COPY --from=build --chown=node:node /app/scripts/tenant-initial-admin.mjs ./scripts/tenant-initial-admin.mjs
COPY --from=build --chown=node:node /app/scripts/database-schema.mjs ./scripts/database-schema.mjs
COPY --from=build --chown=node:node /app/database.sql ./database.sql
COPY --from=build --chown=node:node /app/database/upgrades ./database/upgrades
USER node
EXPOSE 3003 3101
HEALTHCHECK --interval=20s --timeout=4s --start-period=15s --retries=3 CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.MAGISFORM_MANAGER_ROLE==='agent'?'3101':'3003')+'/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "dist-server/manager/index.js"]
